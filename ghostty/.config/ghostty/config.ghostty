# Dynamic theme colors
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-style = Regular
font-size = 12

# Window
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never

# Cursor styling
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

# Keyboard bindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Background and foreground colors
foreground = #e7e9ea
background = #000000

# Standard colors
palette = 0=#121212
palette = 1=#8a8a8a
palette = 2=#e7e9ea
palette = 3=#9e9e9e
palette = 4=#626262
palette = 5=#8a8a8a
palette = 6=#767676
palette = 7=#e0e0e0

# Bright colors
palette = 8=#626262
palette = 9=#9e9e9e
palette = 10=#767676
palette = 11=#b2b2b2
palette = 12=#626262
palette = 13=#8a8a8a
palette = 14=#9e9e9e
palette = 15=#e7e9ea

# # Standard colors
# palette = 0=#333333
# palette = 1=#D35F5F
# palette = 2=#FFC107
# palette = 3=#b91c1c
# palette = 4=#e68e0d
# palette = 5=#D35F5F
# palette = 6=#bebebe
# palette = 7=#bebebe
#
# # Bright colors
# palette = 8=#8a8a8d
# palette = 9=#B91C1C
# palette = 10=#FFC107
# palette = 11=#b90a0a
# palette = 12=#e68e0d
# palette = 13=#D35F5F
# palette = 14=#bebebe
# palette = 15=#bebebe

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Fix for copy pop up
clipboard-paste-bracketed-safe = false
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
selection-invert-fg-bg = true
app-notifications = no-clipboard-copy
clipboard-paste-protection = false
