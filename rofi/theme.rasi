* {
    font:   "Iosevka 12";

    bg0:    #000000E6;
    bg1:    #FFFFFF33;
    bg2:    #FFFFFF;

    fg0:    #DEDEDE;
    fg1:    #000000;
    fg2:    #DEDEDE80;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg0;

    location:       center;
    width:          640;
    border:         1px;
    border-color:   @bg1;
    border-radius:  0;
}

inputbar {
    font:       "Iosevka 13";
    padding:    12px;
    spacing:    12px;
    children:   [ entry ];
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:   inherit;

    placeholder         : "Search";
    placeholder-color   : @fg2;
}

message {
    border:             2px 0 0;
    border-color:       @bg1;
    background-color:   @bg1;
}

textbox {
    padding:    8px 24px;
}

listview {
    lines:      10;
    columns:    1;

    fixed-height:   false;
    border:         1px 0 0;
    border-color:   @bg1;
}

element {
    padding:            8px 16px;
    spacing:            16px;
    background-color:   transparent;
}

element normal.active,
element alternate.active {
    text-color: #FFFFFF;
}

element selected.normal,
element selected.active {
    background-color:   @bg2;
    text-color:         @fg1;
}

element-icon {
    size:   1em;
}

element-text {
    text-color: inherit;
}
