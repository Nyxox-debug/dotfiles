{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "white"
        },
        "padding": {
            "top": 1,
            "right": 4
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "white",
            "title": "white",
            "separator": "90"
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "memory"
    ]
}
